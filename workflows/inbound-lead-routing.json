    {
      "id": "d6f7141c-a64a-5b9b-ba39-390afcd86393",
      "name": "Round robin owner",
      "parameters": {
        "jsCode": "const pools = {\n  Enterprise: ['ae.priya@example.com', 'ae.tom@example.com'],\n  'Mid-market': ['ae.sam@example.com', 'ae.lena@example.com', 'ae.kofi@example.com'],\n  SMB: ['sdr.joe@example.com']\n};\nconst seg = $input.first().json.segment || 'SMB';\nconst pool = pools[seg];\nconst i = $getWorkflowStaticData('global')[seg] = (($getWorkflowStaticData('global')[seg] || 0) + 1) % pool.length;\nreturn [{ json: { ...$input.first().json, owner_email: pool[i] } }];"
      },
      "position": [
        960,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "b32c24a1-a63a-57f2-a5a9-9d1ab8d828ad",
      "name": "Segment by company size",
      "parameters": {
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "SMB"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ Number($json.properties.numberofemployees?.value || 0) }}",
                    "operator": {
                      "operation": "gte",
                      "type": "number"
                    },
                    "rightValue": 1000
                  }
                ]
              },
              "outputKey": "Enterprise"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ Number($json.properties.numberofemployees?.value || 0) }}",
                    "operator": {
                      "operation": "gte",
                      "type": "number"
                    },
                    "rightValue": 250
                  }
                ]
              },
              "outputKey": "Mid-market"
            }
          ]
        }
      },
      "position": [
        720,
        200
      ],
      "type": "n8n-nodes-base.switch",
