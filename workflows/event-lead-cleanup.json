      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const r = item.json;\n  const email = (r['Email'] || '').trim().toLowerCase();\n  const [first, ...rest] = (r['Full name'] || '').trim().split(/\\s+/);\n  return { json: { email, firstname: first || '', lastname: rest.join(' '), company: (r['Company'] || '').trim(), lead_source: 'Event' } };\n}).filter(i => i.json.email.includes('@'));"
      },
